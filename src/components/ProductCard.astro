---
import { categoryLabel, type Product } from "../lib/catalog";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article
  class="flex flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm"
  data-product-card
  data-category={product.category}
  data-name={product.name.toLowerCase()}
>
  <div class="mb-3 flex items-center justify-between text-xs">
    <span class="font-mono text-slate-500">Артикул: {product.sku}</span>
    <span class="rounded-full bg-slate-100 px-2 py-0.5 text-slate-600">
      {categoryLabel(product.category)}
    </span>
  </div>

  <h3 class="text-lg font-semibold">{product.name}</h3>
  <p class="mt-1 text-sm text-slate-600">{product.description}</p>

  <dl class="mt-4 flex-1 space-y-1.5 text-sm">
    {
      product.specs.map((spec) => (
        <div class="flex justify-between gap-4 border-b border-dashed border-slate-100 pb-1.5">
          <dt class="text-slate-500">{spec.label}</dt>
          <dd class="text-right font-medium">{spec.value}</dd>
        </div>
      ))
    }
  </dl>

  <div class="mt-4 flex items-center justify-between">
    <span class="text-sm font-medium text-slate-700">Цена по запросу</span>
    <button
      type="button"
      data-add-sku={product.sku}
      class="rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-indigo-500"
    >
      В корзину
    </button>
  </div>
</article>
