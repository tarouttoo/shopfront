---
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import FilterIsland from "../components/FilterIsland";
import { PRODUCTS } from "../lib/catalog";
---

<Base
  title="Каталог — Витрина"
  description="Каталог оборудования с характеристиками. Цены по запросу."
>
  <section class="mx-auto max-w-5xl px-4 py-10">
    <h1 class="text-3xl font-bold tracking-tight">Каталог</h1>
    <p class="mt-2 text-sm text-slate-600">
      Цены по запросу: добавьте позиции в корзину и оформите заявку — мы выставим счёт.
    </p>

    <div class="mt-6">
      <FilterIsland client:only="react" />
    </div>

    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {PRODUCTS.map((product) => <ProductCard product={product} />)}
    </div>
    <!-- The Cart button lives in the base layout header now; the add
         clicks here are delegated by the header island (CartButtons). -->
  </section>
</Base>
