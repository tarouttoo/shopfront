---
import Base from "../layouts/Base.astro";
import OrderForm from "../components/OrderForm";
import { PRODUCTS } from "../lib/catalog";
---

<Base
  title="Заявка — Витрина"
  description="Оформление заявки: позиции из корзины и реквизиты для счёта."
>
  <section class="mx-auto max-w-5xl px-4 py-10">
    <h1 class="text-3xl font-bold tracking-tight">Оформление заявки</h1>
    <p class="mt-2 mb-8 text-sm text-slate-600">
      Проверьте состав заявки и оставьте реквизиты — мы выставим счёт или КП.
    </p>
    <OrderForm client:only="react" products={[...PRODUCTS]} />
  </section>
</Base>
