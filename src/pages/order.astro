---
import Base from "../layouts/Base.astro";
import OrderForm from "../components/OrderForm";
import { PRODUCTS } from "../lib/catalog";

// Recurring visitor questions, answered in GLOSSARY.md vocabulary only:
// Заявка, Счёт/КП, «Цена по запросу» — no «заказ», no site-side payment
// (ADR 0021: B2B order flow, invoice issued outside the site).
const faq = [
  {
    question: "Что происходит после отправки заявки?",
    answer:
      "Мы связываемся с вами и выставляем счёт или КП по составу заявки.",
  },
  {
    question: "Есть ли онлайн-оплата?",
    answer: "Нет. Оплата — после согласования, по счёту.",
  },
  {
    question: "Почему цены указаны как «по запросу»?",
    answer: "Комплектации и условия различаются, итоговую стоимость фиксирует счёт.",
  },
  {
    question: "Можно ли включить в заявку одну позицию?",
    answer: "Да, заявка собирается из любых позиций каталога.",
  },
];
---

<Base
  title="Заявка — Витрина"
  description="Оформление заявки: позиции из корзины и реквизиты для счёта."
>
  <section class="mx-auto max-w-5xl px-4 py-10">
    <h1 class="text-3xl font-bold tracking-tight">Оформление заявки</h1>
    <p class="mt-2 mb-8 text-sm text-slate-600">
      Проверьте состав заявки и оставьте реквизиты — мы выставим счёт или КП.
    </p>
    <OrderForm client:only="react" products={[...PRODUCTS]} />
  </section>

  <section id="faq" class="mx-auto max-w-5xl px-4 pb-12">
    <h2 class="text-2xl font-semibold">Частые вопросы</h2>
    <div class="mt-6 grid gap-4">
      {
        faq.map((item) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <h3 class="font-semibold">{item.question}</h3>
            <p class="mt-2 text-sm text-slate-600">{item.answer}</p>
          </div>
        ))
      }
    </div>
  </section>
</Base>
