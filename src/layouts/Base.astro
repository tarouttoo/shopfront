---
import "../styles/global.css";
import { SITE } from "../data/site";
import { withBase } from "../lib/urls";
import CartButtons from "../components/CartButtons";

interface Props {
  title: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;

// Favicon per the approved source: the monogram on the primary tile.
const favicon = `data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230d47a1'/%3E%3Ctext x='32' y='43' font-family='Arial' font-size='24' font-weight='bold' fill='%23fff' text-anchor='middle'%3E${SITE.monogram}%3C/text%3E%3C/svg%3E`;

const [phoneMain, phoneSecond] = SITE.phones;

// Approved navigation (Spec #4, T1): the agreed routes. The Category
// and Services pages may not exist yet (later tickets) — link to them
// regardless. No aggregate /catalog tab: the approved design has none,
// the page is removed (ADR 0024).
const NAV = [
  { href: "nasosy/", label: "Насосы" },
  { href: "kotly/", label: "Котлы" },
  { href: "gorelki/", label: "Горелки" },
  { href: "avtomatika/", label: "Автоматика" },
  { href: "services/", label: "Услуги" },
] as const;
---

<!doctype html>
<html lang="ru" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Public and indexable (ADR 0022 lifted ADR 0020/0021's
         until-approval gate): no robots meta, robots.txt allows, and
         the sitemap integration lists every page. -->
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d47a1" />
    <link rel="icon" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-ink antialiased">
    <header class="sticky top-0 z-[1000] bg-white shadow-header">
      <!-- Dark top bar with the contacts (approved source frame) -->
      <div class="bg-primary-dark text-sm text-white">
        <div
          class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-between gap-2.5 px-5 py-2"
        >
          <div class="flex flex-wrap items-center gap-2">
            <a
              href={`tel:${phoneMain.tel}`}
              class="inline-flex items-center gap-1.5 text-white/90 transition-colors hover:text-white"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="h-[15px] w-[15px] shrink-0"
                aria-hidden="true"
              >
                <path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              {phoneMain.display}
            </a>
            <span class="text-white/40" aria-hidden="true">|</span>
            <a
              href={`tel:${phoneSecond.tel}`}
              class="text-white/90 transition-colors hover:text-white"
            >
              {phoneSecond.display}
            </a>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <a
              href={`mailto:${SITE.email}`}
              class="text-white/90 transition-colors hover:text-white"
            >
              {SITE.email}
            </a>
            <span class="text-white/40" aria-hidden="true">|</span>
            <span>{SITE.addressShort}</span>
          </div>
        </div>
      </div>
      <!-- Main row: logo, nav, cart, mobile toggle -->
      <div
        class="relative mx-auto flex max-w-[1240px] items-center justify-between gap-4 px-5 py-3.5"
      >
        <a
          href={withBase("")}
          class="flex items-center gap-3 text-[1.25rem] font-extrabold text-primary"
        >
          <span
            class="flex h-[46px] w-[46px] shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-primary to-accent text-xl font-extrabold text-white shadow-logo"
          >
            {SITE.monogram}
          </span>
          <span class="leading-[1.15]">
            <span class="block">{SITE.brand}</span>
            <span
              class="mt-0.5 block text-[11.5px] font-medium tracking-[0.3px] text-ink-light"
            >
              {SITE.tagline}
            </span>
          </span>
        </a>
        <nav
          id="site-nav"
          data-open="false"
          class="hidden max-md:absolute max-md:top-full max-md:-left-5 max-md:-right-5 max-md:flex-col max-md:items-stretch max-md:border-t max-md:border-haze max-md:bg-white max-md:px-5 max-md:pb-5 max-md:pt-2 max-md:shadow-[0_16px_32px_rgba(13,71,161,0.12)] md:flex md:flex-row md:items-center md:gap-[22px] data-[open=true]:flex"
        >
          {
            NAV.map((item) => (
              <a
                href={withBase(item.href)}
                class="text-[15px] font-medium text-ink transition-colors hover:text-primary max-md:w-full max-md:border-b max-md:border-haze max-md:py-3.5"
              >
                {item.label}
              </a>
            ))
          }
          <a
            href={withBase("order/")}
            class="rounded-btn bg-primary px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-px hover:bg-primary-dark hover:shadow-lift max-md:mt-3 max-md:py-3 max-md:text-center"
          >
            Оставить заявку
          </a>
        </nav>
        <div class="flex shrink-0 items-center gap-3">
          <!-- client:load — the button prerenders into the sticky
               header (a client:only mount shifts the row when the
               island pops in); the Cart store attaches client-side
               (ADR 0027), the prerendered badge stays hidden. -->
          <CartButtons client:load />
          <button
            id="menu-toggle"
            type="button"
            class="group p-1 leading-none text-primary md:hidden"
            aria-label="Меню"
            aria-expanded="false"
            aria-controls="site-nav"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="block h-7 w-7 group-aria-expanded:hidden"
              aria-hidden="true"
            >
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="hidden h-7 w-7 group-aria-expanded:block"
              aria-hidden="true"
            >
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-deep pb-7 pt-12 text-white/80">
      <div class="mx-auto max-w-[1240px] px-5">
        <div class="mb-9 grid gap-10 md:grid-cols-[2fr_1fr_1fr]">
          <div>
            <a
              href={withBase("")}
              class="mb-3.5 flex items-center gap-3 text-[1.25rem] font-extrabold text-white"
            >
              <span
                class="flex h-[46px] w-[46px] shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-primary to-accent text-xl font-extrabold text-white shadow-logo"
              >
                {SITE.monogram}
              </span>
              <span class="leading-[1.15]">{SITE.brand}</span>
            </a>
            <p class="max-w-[340px] text-[0.92rem] leading-[1.7]">{SITE.about}</p>
          </div>
          <div>
            <h4 class="mb-4 text-base font-semibold text-white">Навигация</h4>
            <nav aria-label="Навигация в подвале">
              {
                NAV.map((item) => (
                  <a
                    href={withBase(item.href)}
                    class="mb-2.5 block text-[0.92rem] transition-colors hover:text-white"
                  >
                    {item.label}
                  </a>
                ))
              }
            </nav>
          </div>
          <div>
            <h4 class="mb-4 text-base font-semibold text-white">Контакты</h4>
            {
              SITE.phones.map((phone) => (
                <a
                  href={`tel:${phone.tel}`}
                  class="mb-2.5 block text-[0.92rem] transition-colors hover:text-white"
                >
                  {phone.display}
                </a>
              ))
            }
            <a
              href={`mailto:${SITE.email}`}
              class="mb-2.5 block text-[0.92rem] transition-colors hover:text-white"
            >
              {SITE.email}
            </a>
            <p class="mb-2.5 text-[0.92rem]">{SITE.address}</p>
            <p class="text-[0.92rem]">{SITE.workingHours}</p>
          </div>
        </div>
        <div
          class="flex flex-wrap items-center justify-between gap-3 border-t border-white/10 pt-[22px] text-[0.85rem]"
        >
          <div>{SITE.copyright}</div>
          <div class="flex flex-wrap items-center gap-3">
            <span>{SITE.inn} · {SITE.ogrn}</span>
            <a
              href={withBase(SITE.privacyPath)}
              class="transition-colors hover:text-white hover:underline"
            >
              Политика конфиденциальности
            </a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      // Mobile menu (approved source behavior): the toggle flips
      // aria-expanded and the nav's data-open; the icons swap through
      // the group-aria-expanded utilities. Any nav link click closes it.
      const toggle = document.getElementById("menu-toggle");
      const nav = document.getElementById("site-nav");
      if (toggle && nav) {
        const setMenu = (open) => {
          nav.dataset.open = String(open);
          toggle.setAttribute("aria-expanded", String(open));
        };
        toggle.addEventListener("click", () => setMenu(nav.dataset.open !== "true"));
        nav.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => setMenu(false));
        });
      }
    </script>
  </body>
</html>
