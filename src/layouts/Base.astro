---
import "../styles/global.css";
import { withBase } from "../lib/urls";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Каталог оборудования. Цены по запросу — счёт по заявке в один клик.",
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Public and indexable (ADR 0022 lifted ADR 0020/0021's
         until-approval gate): no robots meta, robots.txt allows, and
         the sitemap integration lists every page. -->
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-900">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
        <a href={withBase("")} class="text-lg font-semibold tracking-tight">Витрина</a>
        <nav class="flex items-center gap-5 text-sm">
          <a href={withBase("catalog/")} class="text-slate-600 hover:text-indigo-600">Каталог</a>
          <a href={withBase("")} class="text-slate-600 hover:text-indigo-600">Как заказать</a>
          <a
            href={withBase("order/")}
            class="rounded-md bg-indigo-600 px-3 py-1.5 font-medium text-white hover:bg-indigo-500"
          >
            Заявка
          </a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-slate-200 bg-white">
      <div class="mx-auto max-w-5xl px-4 py-6 text-xs text-slate-500">
        <p>Черновик витрины. Контактные данные появятся после одобрения публикации.</p>
      </div>
    </footer>
  </body>
</html>
